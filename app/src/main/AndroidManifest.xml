<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        READ_PHONE_STATE and READ_CALL_LOG are runtime permissions, asked together the moment the
        user turns the feature on: the first delivers the ringing broadcast, the second the caller's
        number in it and the earlier call in the log. READ_CALL_LOG is why this app cannot be on
        Google Play without a policy exception: Play reserves it for default dialers and a short list
        of call-related app types.

        POST_NOTIFICATIONS is asked alongside on Android 13+, for the ringing notification's
        Silence button. The ringing itself does not depend on it.

        FOREGROUND_SERVICE_MEDIA_PLAYBACK is the type the ringing service declares from Android 14.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!--
        READ_CONTACTS is asked when the user presses Add from contacts or turns on Everyone in your
        contacts, never at launch. The picker keeps only the callers the user taps; the ring-time check
        looks up a repeated call's number and keeps nothing.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Package visibility (API 30+) for the one OEM screen the app offers to open: Xiaomi's
        autostart manager, which on HyperOS decides whether background work runs at all. Without
        this declaration `resolveActivity` returns null on a phone where the activity exists, and
        the app would either hide a button that works or show one that does nothing.

        A named package, not QUERY_ALL_PACKAGES: we look for exactly one thing and say which.

        The three <intent> entries are for hand-offs to a mail app, Play and a browser. None of the
        launches needs them — package visibility has never blocked `startActivity`, and each launch
        is a try/catch around `ActivityNotFoundException`. What visibility *does* block is
        `resolveActivity`, which would answer "no mail app" on every phone that has one. Nothing
        performs such a pre-check today; these entries exist so one added later cannot silently lie.
    -->
    <queries>
        <package android:name="com.miui.securitycenter" />

        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!--
        `android:localeConfig` is read by Android 13+ only, which is what tools:targetApi records —
        it silences lint's "unused below minSdk" note without weakening anything at runtime. Older
        devices ignore the attribute and AppCompat's backport reads the same file, so the list of
        shipped languages stays in one place across the whole supported range (ADR-0004).

        Platform Auto Backup carries the preference store, and that is all there is: the settings,
        the chosen callers and a theme, all welcome on the user's next phone.
    -->
    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.App"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            `exported="true"` because the sender is the telephony process, not this app.
            PHONE_STATE is a protected broadcast, so no other app can send it here.
        -->
        <receiver
            android:name=".call.PhoneStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!--
            Restarts Run in the background after a reboot or an update, when nothing else would start it
            until the user opens Urgent.
        -->
        <receiver
            android:name=".call.KeepAliveRestartReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".call.RingThroughService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".call.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the phone-state receiver's process alive between calls, while the user has switched on Run in the background." />
        </service>

        <!--
            Not a service anybody starts — `android:enabled="false"` means it can never run. It is a
            manifest entry used as a storage slot: AppCompat looks itself up here, reads the
            `autoStoreLocales` flag, and takes responsibility for persisting the chosen language on
            devices below 13, where the platform has no per-app locale store of its own. On 13+ the
            framework persists it and this is ignored.

            Chosen over a DataStore key deliberately (ADR-0004): DataStore reads are asynchronous —
            a Flow, so `suspend` before the value exists — and the app would already have drawn its
            first frame in the phone's language before the stored one resolved.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
